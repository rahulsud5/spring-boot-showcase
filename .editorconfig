# Consistent formatting across IDEs: one less thing to argue about in code review.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,graphqls}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
